AUTH_DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/auth_db
REPORTS_DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/reports_db
NOTIFICATIONS_DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/notifications_db
AUTH_REDIS_URL=redis://<HOST>:<PORT>/0
JWT_SECRET=jwt_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_TTL_SEC=300
GENERATE_DEFAULT_OTP=False

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=твой@yandex.ru
SMTP_PASSWORD=пароль_приложения
SMTP_FROM=твой@yandex.ru

# Web Push (VAPID) — generate: python3 -c "from cryptography.hazmat.primitives.asymmetric import ec; import base64; k=ec.generate_private_key(ec.SECP256R1()); ..."
VAPID_PRIVATE_KEY=<base64url_private_key>
VAPID_PUBLIC_KEY=<base64url_public_key>
VAPID_CONTACT_EMAIL=admin@your-domain.tech